# ============================================================
# CREDENCIAL DESTA CONTA — E DE MAIS NENHUMA
# Copie para .env na MESMA pasta e preencha.
# Nunca versione o .env. Nunca copie um .env de uma pasta para outra.
# ============================================================

# App do ML (pode ser o mesmo app para todas as contas)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Mesma string cadastrada no DevCenter. O ML NÃO aceita localhost —
# use um endereço HTTPS público (ex: uma rota inexistente do seu domínio).
ML_REDIRECT_URI=

# Específicos DESTA conta (vêm do consentimento OAuth desta conta)
ML_USER_ID=
ML_REFRESH_TOKEN=

# Preenchidos automaticamente pelo sistema — não mexa
ML_ACCESS_TOKEN=
ML_TOKEN_EXPIRA_EM=0
