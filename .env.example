# Credenciais dos canais de notificação.
# Copie para .env NA RAIZ do projeto e preencha só o provedor que você usa.
# Este arquivo é diferente dos .env das contas — aqui não tem nada do ML.

# --- Evolution API ---
EVOLUTION_API_KEY=

# --- Z-API ---
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Caixa de correio do Mercado Livre (Zion-OS) ---
# O ML avisa o Zion-OS, que guarda só o ponteiro (tópico + caminho). Esta
# máquina drena e lê o recurso com o token da conta, que nunca sai daqui.
# CRON_SECRET é a MESMA do worker do Zion-OS — leia lá, não invente outra.
ZION_OS_URL=https://www.zioncompany.online
CRON_SECRET=
